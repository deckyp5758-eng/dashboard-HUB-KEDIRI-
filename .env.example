# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_SHEETS_API_KEY: Required for Google Sheets API calls (fallback server-side cache).
GOOGLE_SHEETS_API_KEY="YOUR_API_KEY"

# GAS_WEBAPP_URL: URL Deployment Google Apps Script (Code.gs) - Bebas Kuota API
GAS_WEBAPP_URL=""

# GITHUB_RAW_DATA_URL: URL Raw JSON di GitHub yang disinkronkan oleh Code.gs
GITHUB_RAW_DATA_URL=""

# SYNC_WEBHOOK_SECRET: Kunci keamanan opsional untuk webhook Code.gs -> Web App
SYNC_WEBHOOK_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
